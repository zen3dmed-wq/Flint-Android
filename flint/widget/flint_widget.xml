<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/flint_widget_background">
    <LinearLayout android:id="@+id/flint_widget_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:contentDescription="Открыть приложение Flint">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/flint_emblem"
            android:scaleType="fitCenter" android:contentDescription="Эмблема Flint" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
            android:text="FLINT" android:textSize="21sp" android:textStyle="bold" android:textColor="#F8FBFF" />
    </LinearLayout>
    <TextView android:id="@+id/flint_widget_status" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:text="Проверка VPN…" android:textSize="16sp"
        android:textColor="#C3D5DF" android:maxLines="2" android:ellipsize="end" />
    <Button android:id="@+id/flint_widget_toggle" android:layout_width="match_parent" android:layout_height="48dp"
        android:background="@drawable/flint_widget_button" android:text="Открыть Flint" android:textAllCaps="false"
        android:textColor="#08201B" android:textSize="15sp" android:textStyle="bold" />
</LinearLayout>
