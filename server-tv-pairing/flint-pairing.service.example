[Unit]
Description=Flint TV QR pairing relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flint-pairing
Group=flint-pairing
ExecStart=/opt/flint-pairing/flint-pairing-linux-amd64 -listen 127.0.0.1:8099 -upstream https://flintmain.ru/api/v1 -trust-loopback-proxy
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M

[Install]
WantedBy=multi-user.target
