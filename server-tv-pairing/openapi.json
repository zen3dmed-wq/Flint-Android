    "/api/v1/devices/pairing/distribution": {
      "get": {
        "operationId": "DevicePairingDistribution",
        "security": [],
        "responses": {
          "200": {
            "description": "Public installation links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "androidUrl": {
                      "type": "string"
                    },
                    "iosUrl": {
                      "type": "string"
                    },
                    "windowsUrl": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "androidUrl",
                    "iosUrl",
                    "windowsUrl"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/connect/{pairingId}": {
      "get": {
        "operationId": "DevicePairingInstallPage",
        "security": [],
        "parameters": [
          {
            "name": "pairingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "description": "Public HTML. Encryption key exists only in URL fragment #key=... and must never be sent to the server. User explicitly installs the app, then returns and opens Flint or rescans.",
        "responses": {
          "200": {
            "description": "Installation page"
          },
          "404": {
            "description": "Invalid identifier"
          }
        }
      }
    },
    "/api/v1/devices/pairing/download/android": {
      "get": {
        "operationId": "DownloadFlintAndroid",
        "security": [],
        "responses": {
          "200": {
            "description": "Public configured software download",
            "content": {
              "application/vnd.android.package-archive": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "HTTP byte range"
          },
          "404": {
            "description": "Distribution file is not configured"
          }
        }
      }
    },
    "/api/v1/devices/pairing/download/windows": {
      "get": {
        "operationId": "DownloadFlintWindows",
        "security": [],
        "responses": {
          "200": {
            "description": "Public configured software download",
            "content": {
              "application/vnd.microsoft.portable-executable": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "HTTP byte range"
          },
          "404": {
            "description": "Distribution file is not configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Device": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "type": "string",
            "maxLength": 128
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "android-tv",
              "windows",
              "ios"
            ]
          },
          "model": {
            "type": "string",
            "maxLength": 120
          },
          "osVersion": {
            "type": "string",
            "maxLength": 40
          },
          "appVersion": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "deviceId",
          "platform",
          "model"
        ]
      },
      "Envelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "nonce": {
            "type": "string",
            "description": "base64url, no padding; 12 bytes"
          },
          "ciphertext": {
            "type": "string",
            "maxLength": 699076,
            "description": "base64url AES-256-GCM ciphertext including 16-byte tag"
          }
        },
        "required": [
          "version",
          "nonce",
          "ciphertext"
        ]
      },
      "Start": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
