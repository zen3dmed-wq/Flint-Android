{
  "openapi": "3.0.3",
  "info": {
    "title": "Flint device pairing API",
    "version": "1.1.0",
    "description": "Encrypted VPN configuration handoff for Android, Android TV, Windows and iOS. No account session is transferred. Owner QR: HTTPS /connect/{id}#key=...; receiver QR: flint://pair?v=1&id=...#key=... . The production server has not been changed by this package."
  },
  "servers": [
    {
      "url": "https://flintmain.ru"
    }
  ],
